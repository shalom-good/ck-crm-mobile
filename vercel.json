{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/mobile/:path*", "destination": "https://ck-crm.vercel.app/api/mobile/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
