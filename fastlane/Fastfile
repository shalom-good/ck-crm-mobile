# CK Team — iOS delivery
#
# Mac-free signing: authentication uses an App Store Connect API key (.p8),
# and Xcode automatic signing (-allowProvisioningUpdates) creates/downloads the
# distribution certificate + provisioning profile on the runner. No local Mac,
# no Keychain, no manually-created certs.
#
# The archive is built UNSIGNED (skip_codesigning) and signed at export time,
# so automatic signing requests an app-store *distribution* profile (which needs
# no registered devices) instead of a *development* one.
#
# Required environment (set as GitHub Actions secrets — see APPLE-DEPLOY.md):
#   ASC_KEY_ID        App Store Connect API key id
#   ASC_ISSUER_ID     App Store Connect issuer id
#   ASC_KEY_P8        the .p8 private key, base64-encoded
#   APPLE_TEAM_ID     the 10-char Apple Developer Team ID
#   BUILD_NUMBER      (optional) CI run number, used as the build number

require "base64"

default_platform(:ios)

APP_ID = "net.collectivekindness.ckteam"
# Capacitor apps must build the CocoaPods-generated workspace, not the bare
# .xcodeproj — otherwise the Pods (incl. the Capacitor module) aren't linked.
WORKSPACE = "ios/App/App.xcworkspace"
SCHEME = "App"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Build a signed release IPA and upload it to TestFlight"
  lane :beta do
    key = asc_api_key
    team = ENV.fetch("APPLE_TEAM_ID")
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    # gym has no api_key option, so authenticate xcodebuild's export step for
    # -allowProvisioningUpdates by writing the decoded .p8 and passing the App
    # Store Connect authentication flags. The archive is unsigned; the export
    # signs it for the app-store (distribution) method.
    key_path = File.expand_path("AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8")))
    auth = "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
           "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      skip_codesigning: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} DEVELOPMENT_TEAM=#{team}",
      export_xcargs: "-allowProvisioningUpdates #{auth}",
      export_options: {
        signingStyle: "automatic",
        teamID: team
      },
      output_directory: "build",
      output_name: "CKTeam.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_ID,
      ipa: "build/CKTeam.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
